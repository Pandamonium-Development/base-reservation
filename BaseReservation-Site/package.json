{
  "name": "basereservation-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "api-base-reservation:generate": "openapi-typescript ./src/api/base-reservation/spec.json -o ./src/api/base-reservation/api.d.ts",
    "api-base-reservation:update-local": "curl -s http://localhost:5001/swagger/v1/swagger.json -o ./src/api/base-reservation/spec.json && sed -i '' 's/; x-api-version=[0-9]*//' ./src/api/base-reservation/spec.json && npx openapi-typescript ./src/api/base-reservation/spec.json -o ./src/api/base-reservation/api.d.ts --bare"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^3.10.0",
    "@mui/icons-material": "^6.3.1",
    "@mui/material": "^6.3.1",
    "@mui/x-data-grid": "^7.23.5",
    "@tanstack/react-query": "^5.62.15",
    "@types/lodash": "^4.17.14",
    "lodash": "^4.17.21",
    "openapi-fetch": "^0.13.3",
    "openapi-typescript": "^6.7.6",
    "openapi-typescript-fetch": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.1.1",
    "yup": "^1.6.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-helmet": "^6.1.11",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  }
}
